{"id":2560,"date":"2016-09-25T16:03:50","date_gmt":"2016-09-25T15:03:50","guid":{"rendered":"http:\/\/microclub.ch\/?p=2560"},"modified":"2016-11-21T20:10:44","modified_gmt":"2016-11-21T19:10:44","slug":"40eme-anniversaire-du-microclub-24-septembre-2016-a-renens","status":"publish","type":"post","link":"https:\/\/microclub.ch\/2016\/09\/25\/40eme-anniversaire-du-microclub-24-septembre-2016-a-renens\/","title":{"rendered":"40\u00e8me anniversaire du Microclub, 24 septembre 2016 \u00e0 Renens"},"content":{"rendered":"<p><em><span style=\"color: #2c2b2b;\"><span style=\"font-family: arial;\">Pour notre 40\u00e8me anniversaire, une quarantaine de personnes se sont retrouv\u00e9es au Refuge du Censuy \u00e0 Renens pour un Repas-Expo. Ce fut l\u2019occasion de retrouver quelques membres fondateurs, d&rsquo;anciens pr\u00e9sidents, ainsi que les membres actifs actuels. Durant l\u2019ap\u00e9ritif, <a href=\"http:\/\/microclub.ch\/wp-content\/uploads\/2016\/09\/DiscoursDuPresidentDu40e_092016.pdf\">le discours de notre pr\u00e9sident <\/a>R\u00e9my et <a href=\"http:\/\/microclub.ch\/wp-content\/uploads\/2016\/09\/Microclub-1976-2016-40-ans.pdf\">un historique <\/a>de notre club par Yves nous a permis de revivre 40 ann\u00e9es de passion pour l&rsquo;informatique. Les intenses discussions ont continu\u00e9 durant tout le savoureux repas.\u00a0<\/span><\/span><\/em><\/p>\n<p><em>Une exposition de quelques anciens projets nous a permis de revivre 40 ann\u00e9es d&rsquo;\u00e9volution \u00e9lectronique et informatique.<\/em><\/p>\n<p>[supsystic-gallery id=3]<\/p>\n<p><a href=\"http:\/\/microclub.ch\/wp-content\/uploads\/2016\/09\/DiscoursDuPresidentDu40e_092016.pdf\">Discours du pr\u00e9sident, R\u00e9my Pilliard<\/a><\/p>\n<p><a href=\"http:\/\/microclub.ch\/wp-content\/uploads\/2016\/09\/Microclub-1976-2016-40-ans.pdf\">Discours de l&rsquo;historie du club, Yves Masur<\/a><\/p>\n<p>&nbsp;<\/p>\n","protected":false},"excerpt":{"rendered":"<p>Pour notre 40\u00e8me anniversaire, une quarantaine de personnes se sont retrouv\u00e9es au Refuge du Censuy \u00e0 Renens pour un Repas-Expo.<\/p>\n","protected":false},"author":37,"featured_media":0,"comment_status":"open","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"colormag_page_container_layout":"default_layout","colormag_page_sidebar_layout":"default_layout","footnotes":""},"categories":[166],"tags":[275,274,5,254],"class_list":["post-2560","post","type-post","status-publish","format-standard","hentry","category-microclub","tag-40ans","tag-anniversaire","tag-epfl","tag-microclub-2"],"_links":{"self":[{"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/posts\/2560","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/users\/37"}],"replies":[{"embeddable":true,"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/comments?post=2560"}],"version-history":[{"count":10,"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/posts\/2560\/revisions"}],"predecessor-version":[{"id":2578,"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/posts\/2560\/revisions\/2578"}],"wp:attachment":[{"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/media?parent=2560"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/categories?post=2560"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/microclub.ch\/wp-json\/wp\/v2\/tags?post=2560"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}